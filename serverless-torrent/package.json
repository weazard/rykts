{
  "name": "serverless-torrent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Semi-stateless, serverless-native BitTorrent leech for Vercel: browser holds durable state, functions do bounded outbound TCP downloading.",
  "scripts": {
    "dev": "node --experimental-strip-types dev-server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "ffmpeg-static": "^5.3.0"
  }
}